# ---------------------------------------------------------------------------
# Copy to .env and adjust if any host port is already in use. Every value here
# has a working default baked into the code and into docker-compose.yml, so
# `docker compose up` works with no .env at all.
# ---------------------------------------------------------------------------

# --- Host ports (left side of the compose port mappings) ---
API_HOST_PORT=3000
TEMPORAL_UI_PORT=8080
TEMPORAL_GRPC_PORT=7233
REDIS_HOST_PORT=6379

# --- API ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Suppliers ---
# Inside compose these point at the api service by its DNS name. Running the
# app on the host instead, use http://localhost:3000/...
SUPPLIER_A_URL=http://app-api:3000/supplierA/hotels
SUPPLIER_B_URL=http://app-api:3000/supplierB/hotels
SUPPLIER_TIMEOUT_MS=5000

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=hotels
# How long a city's cached snapshot lives before the next request re-runs the workflow
REDIS_TTL_SECONDS=300

# --- Temporal datastore (compose only; never published to the host) ---
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
# Startup safety net for the race between "port is open" and "namespace exists"
TEMPORAL_CONNECT_MAX_ATTEMPTS=30
TEMPORAL_CONNECT_INITIAL_DELAY_MS=500
TEMPORAL_CONNECT_MAX_DELAY_MS=5000
